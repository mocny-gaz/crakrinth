{
	"bundle": {
		"createUpdaterArtifacts": "v1Compatible"
	},
	"build": {
		"features": ["updater"]
	},
	"app": {
		"security": {
			"capabilities": ["ads", "core", "plugins", "updater"]
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "SET_BY_RELEASE_WORKFLOW",
			"endpoints": ["https://github.com/mocny-gaz/crakrinth/releases/latest/download/latest.json"],
			"windows": {
				"installMode": "quiet"
			}
		}
	}
}
